<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio</title>
    <style>
        body { margin: 0; padding: 0; font-family: Arial, sans-serif; display: flex; flex-direction: column; height: 100vh; }
        .header { background: #24292e; color: white; padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2px 5px rgba(0,0,0,0.2); }
        .title { font-size: 18px; font-weight: bold; }
        .btn { background: #2ea44f; color: white; text-decoration: none; padding: 8px 16px; border-radius: 6px; font-weight: bold; font-size: 14px; transition: background 0.2s; }
        .btn:hover { background: #22863a; }
        iframe { width: 100%; flex-grow: 1; border: none; }
    </style>
</head>
<body>
    <div class="header">
        <div class="title">My Portfolio</div>
        <a href="portfolio.pdf" download class="btn">📥 Download PDF</a>
    </div>
    <iframe src="portfolio.pdf"></iframe>
</body>
</html>
